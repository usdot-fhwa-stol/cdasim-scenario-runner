CURRENT_DIR=$(pwd)
LOCK_FILE="/tmp/cdasim-scenario-runner-stop.lock"
CLEANUP_FAILED=0

exec 9>"$LOCK_FILE"
if ! flock 9; then
    echo "Error: Could not acquire the scenario cleanup lock." >&2
    exit 1
fi

remove_compose_project_containers() {
    local project_name="$1"
    local remaining_containers

    if ! remaining_containers=$(docker ps -aq \
        --filter "label=com.docker.compose.project=$project_name"); then
        echo "Error: Could not inspect remaining containers for $project_name." >&2
        CLEANUP_FAILED=1
        return
    fi

    if [ -n "$remaining_containers" ]; then
        echo "Removing remaining containers for Compose project $project_name..."
        if ! docker rm -f $remaining_containers; then
            echo "Error: Could not remove all containers for $project_name." >&2
            CLEANUP_FAILED=1
        fi
    fi
}

remove_named_container() {
    local container_name="$1"

    if docker container inspect "$container_name" >/dev/null 2>&1; then
        if ! docker rm -f "$container_name"; then
            echo "Error: Could not remove container $container_name." >&2
            CLEANUP_FAILED=1
        fi
    fi
}

remove_network() {
    local network_name="$1"
    local attempt

    if ! docker network inspect "$network_name" >/dev/null 2>&1; then
        return
    fi

    for attempt in 1 2 3; do
        if docker network rm "$network_name"; then
            return
        fi
        echo "Network $network_name is still in use; retrying ($attempt/3)..." >&2
        sleep 1
    done

    echo "Error: Could not remove network $network_name." >&2
    CLEANUP_FAILED=1
}

echo "Stopping scenario..."

{% for c in scenario %}
if ! docker compose \
{% for compose_file in c.compose_files %}               -f "{{ compose_file }}" \
{% endfor %}               --env-file "{{ c.env_file }}" \
               -p "{{ c.PROJECT_NAME }}" \
               down --remove-orphans; then
    echo "Warning: Compose cleanup failed for {{ c.PROJECT_NAME }}; checking for remaining containers." >&2
fi
remove_compose_project_containers "{{ c.PROJECT_NAME }}"
{% endfor %}

# CARLA and NS-3 are launched by CDASim through the host Docker socket, so
# they are not members of a Compose project and must be removed separately.
for runtime_container in "carla-server" "ns3-federate"; do
    remove_named_container "$runtime_container"
done

{% for config_container in config_containers %}
remove_named_container "{{ config_container.name }}"
{% endfor %}

{% for network in networks %}
remove_network "{{ network.name }}"
{% endfor %}

if ! cd "$CURRENT_DIR"; then
    CLEANUP_FAILED=1
fi

if [ "$CLEANUP_FAILED" -ne 0 ]; then
    echo "Scenario cleanup completed with errors." >&2
    exit 1
fi

echo "Scenario stopped successfully."
