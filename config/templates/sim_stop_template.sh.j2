CLEANUP_FAILED=0
DOCKER_SOCKET_PATH="/var/run/docker.sock"

# Docker Compose evaluates the complete model during `down`. Export the host
# socket group ID here as well as in the start script so the CDASim group_add
# interpolation remains valid in this separate shell process.
if [ ! -S "$DOCKER_SOCKET_PATH" ]; then
    echo "Error: $DOCKER_SOCKET_PATH is not a Docker socket." >&2
    exit 1
fi
if ! DOCKER_SOCKET_GID=$(stat -c '%g' "$DOCKER_SOCKET_PATH"); then
    echo "Error: Could not determine the group ID of $DOCKER_SOCKET_PATH." >&2
    exit 1
fi
export DOCKER_SOCKET_GID

# Remove a container by its exact name when it exists. Missing containers are
# treated as already cleaned up so this function is safe to call repeatedly.
# Usage: remove_named_container CONTAINER_NAME
remove_named_container() {
    local container_name="$1"

    if docker container inspect "$container_name" >/dev/null 2>&1; then
        if ! docker rm -f "$container_name"; then
            echo "Error: Could not remove container $container_name." >&2
            CLEANUP_FAILED=1
        fi
    fi
}

# Remove a Docker network by name when it exists. Compose services and dynamic
# runtime containers are removed first so the network should no longer be used.
# Usage: remove_network NETWORK_NAME
remove_network() {
    local network_name="$1"

    if docker network inspect "$network_name" >/dev/null 2>&1; then
        if ! docker network rm "$network_name"; then
            echo "Error: Could not remove network $network_name." >&2
            CLEANUP_FAILED=1
        fi
    fi
}

echo "Stopping scenario..."

# --remove-orphans handles containers from the same Compose project when a
# service was renamed or removed, or when a different config-image/override
# version changed the effective Compose model between scenario runs.
{% for c in scenario %}
if ! docker compose \
{% for compose_file in c.compose_files %}               -f "{{ compose_file }}" \
{% endfor %}               --env-file "{{ c.env_file }}" \
               -p "{{ c.PROJECT_NAME }}" \
               down --remove-orphans; then
    echo "Error: Compose cleanup failed for {{ c.PROJECT_NAME }}." >&2
    CLEANUP_FAILED=1
fi
{% endfor %}

# CARLA and NS-3 are launched by CDASim through the host Docker socket, so
# they are not members of a Compose project and must be removed separately.
for runtime_container in "carla-server" "ns3-federate"; do
    remove_named_container "$runtime_container"
done

{% for config_container in config_containers %}
remove_named_container "{{ config_container.name }}"
{% endfor %}

{% for network in networks %}
remove_network "{{ network.name }}"
{% endfor %}

if [ "$CLEANUP_FAILED" -ne 0 ]; then
    echo "Scenario cleanup completed with errors." >&2
    exit 1
fi

echo "Scenario stopped successfully."
